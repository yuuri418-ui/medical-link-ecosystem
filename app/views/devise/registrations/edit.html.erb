<div class="flex flex-col items-center justify-center py-12 px-4 sm:px-6 lg:px-8">
  <div class="max-w-md w-full space-y-8 bg-white p-10 rounded-xl shadow-lg border border-blue-50">
    <h2 class="text-center text-2xl font-extrabold text-gray-900 tracking-tight">プロフィール編集</h2>

    <%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { method: :put, class: "mt-8 space-y-5" }) do |f| %>
      <%= render "devise/shared/error_messages", resource: resource %>

      <%# 氏名（漢字） %>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= f.label :last_name, "姓", class: "text-xs font-bold text-gray-500 uppercase" %>
          <%= f.text_field :last_name, autofocus: true, class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm" %>
        </div>
        <div>
          <%= f.label :first_name, "名", class: "text-xs font-bold text-gray-500 uppercase" %>
          <%= f.text_field :first_name, class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm" %>
        </div>
      </div>

      <%# 氏名（フリガナ） %>
      <div class="grid grid-cols-2 gap-4">
        <div>
          <%= f.label :last_name_kana, "姓（フリガナ）", class: "text-xs font-bold text-gray-500 uppercase" %>
          <%= f.text_field :last_name_kana, class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm" %>
        </div>
        <div>
          <%= f.label :first_name_kana, "名（フリガナ）", class: "text-xs font-bold text-gray-500 uppercase" %>
          <%= f.text_field :first_name_kana, class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm" %>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-4">
        <%# 性別 %>
        <div>
          <%= f.label :gender, "性別", class: "text-xs font-bold text-gray-500 uppercase" %>
          <%= f.select :gender, [["男性", "male"], ["女性", "female"], ["その他", "other"]], { include_blank: "選択してください" }, 
              class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm bg-white" %>
        </div>
        <%# 携帯番号 %>
        <div>
          <%= f.label :phone_number, "携帯番号", class: "text-xs font-bold text-gray-500 uppercase" %>
          <%= f.telephone_field :phone_number, class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm" %>
        </div>
      </div>

      <%# 生年月日 %>
      <div>
        <%= f.label :birthday, "生年月日", class: "text-xs font-bold text-gray-500 uppercase" %>
        <%= f.date_field :birthday, class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm" %>
      </div>

      <div class="p-4 bg-blue-50 rounded-lg space-y-4">
        <%# 診断名 %>
        <div>
          <%= f.label :diagnosis_name, "診断名（任意）", class: "text-xs font-bold text-blue-700 uppercase" %>
          <%= f.text_field :diagnosis_name, class: "mt-1 block w-full px-3 py-2 border border-blue-200 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm" %>
        </div>
        <%# 治療開始日 %>
        <div>
          <%= f.label :started_at, "治療開始日（または発症時期）", class: "text-xs font-bold text-blue-700 uppercase" %>
          <%= f.date_field :started_at, class: "mt-1 block w-full px-3 py-2 border border-blue-200 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm" %>
        </div>
        <%# 診察券番号 %>
        <div>
          <%= f.label :patient_id, "診察券番号（患者ID）", class: "text-xs font-bold text-blue-700 uppercase" %>
          <%= f.text_field :patient_id, class: "mt-1 block w-full px-3 py-2 border border-blue-200 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm" %>
        </div>
      </div>

      <div class="pt-4 border-t border-gray-100">
        <%# メールアドレス %>
        <div>
          <%= f.label :email, "メールアドレス", class: "text-xs font-bold text-gray-500 uppercase" %>
          <%= f.email_field :email, class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm" %>
        </div>

        <%# パスワード変更（任意） %>
        <div class="mt-4">
          <%= f.label :password, class: "text-xs font-bold text-gray-500 uppercase" do %>
            新しいパスワード <span class="text-[10px] font-normal text-gray-400 font-sans tracking-normal">(変更しない場合は空欄)</span>
          <% end %>
          <%= f.password_field :password, class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm", autocomplete: "new-password" %>
        </div>

        <div class="mt-4">
          <%= f.label :password_confirmation, "パスワード再入力", class: "text-xs font-bold text-gray-500 uppercase" %>
          <%= f.password_field :password_confirmation, class: "mt-1 block w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:ring-blue-500 focus:border-blue-500 sm:text-sm", autocomplete: "new-password" %>
        </div>
      </div>

      <%# 現在のパスワード確認 %>
      <div class="p-4 bg-orange-50 rounded-lg">
        <%= f.label :current_password, class: "text-xs font-bold text-orange-700 uppercase" do %>
          現在のパスワード <span class="text-[10px] font-normal text-orange-600 font-sans tracking-normal">(変更には必須です)</span>
        <% end %>
        <%= f.password_field :current_password, class: "mt-1 block w-full px-3 py-2 border border-orange-200 rounded-md shadow-sm focus:ring-orange-500 focus:border-orange-500 sm:text-sm", autocomplete: "current-password" %>
      </div>

      <%= f.submit "プロフィールを更新する", class: "w-full flex justify-center py-3 px-4 border border-transparent rounded-md shadow-lg text-sm font-bold text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition duration-150 transform hover:-translate-y-0.5" %>
    <% end %>

    <div class="flex justify-between items-center mt-8 pt-6 border-t border-gray-100">
      <%= link_to "← 戻る", :back, class: "text-sm text-gray-500 hover:text-blue-600 no-underline" %>
      
      <%= button_to "アカウントを削除する", registration_path(resource_name), 
          data: { confirm: "本当に削除しますか？", turbo_confirm: "本当に削除しますか？" }, 
          method: :delete, 
          class: "text-xs text-red-400 hover:text-red-600 bg-transparent border-none cursor-pointer underline decoration-red-200" %>
    </div>
  </div>
</div>
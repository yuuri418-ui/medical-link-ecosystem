<h2>Sign up</h2>

<%= form_for(resource, as: resource_name, url: registration_path(resource_name)) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>

  <div class="field">
    <%= f.label :last_name, "姓" %><br />
    <%= f.text_field :last_name, autofocus: true %>
  </div>

  <div class="field">
    <%= f.label :first_name, "名" %><br />
    <%= f.text_field :first_name %>
  </div>

  <div class="field">
    <%= f.label :last_name_kana, "姓（フリガナ）" %><br />
    <%= f.text_field :last_name_kana %>
  </div>

  <div class="field">
    <%= f.label :first_name_kana, "名（フリガナ）" %><br />
    <%= f.text_field :first_name_kana %>
  </div>

  <div class="field">
    <%= f.label :gender, "性別" %><br />
    <%= f.select :gender, [["未選択", "unselected"], ["男性", "male"], ["女性", "female"], ["その他", "other"]] %>
  </div>

  <div class="field">
    <%= f.label :birthday, "生年月日" %><br />
    <%= f.date_field :birthday %>
  </div>

  <div class="field">
    <%= f.label :diagnosis_name, "診断名" %><br />
    <%= f.text_field :diagnosis_name, placeholder: "例：全身性エリテマトーデス（SLE）" %>
  </div>

  <div class="field">
    <%= f.label :started_at, "治療開始日（または発症時期）" %><br />
    <%= f.date_field :started_at %>
  </div>

  <div class="field">
    <%= f.label :phone_number, "携帯番号" %><br />
    <%= f.text_field :phone_number %>
  </div>

  <div class="field">
    <p><%= f.label :email %></p>
    <p><%= f.email_field :email, autofocus: true, autocomplete: "email" %></p>
  </div>

  <div class="field">
    <p><%= f.label :password %></p>
    <% if @minimum_password_length %>
      <p><em>(<%= @minimum_password_length %> characters minimum)</em></p>
    <% end %>
    <p><%= f.password_field :password, autocomplete: "new-password" %></p>
  </div>

  <div class="field">
    <p><%= f.label :password_confirmation %></p>
    <p><%= f.password_field :password_confirmation, autocomplete: "new-password" %></p>
  </div>

  <div class="actions">
    <%= f.submit "Sign up" %>
  </div>
<% end %>

<%= render "devise/shared/links" %>

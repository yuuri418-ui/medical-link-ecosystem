<h1>MyHealth Log へようこそ</h1>

<% if user_signed_in? %>
  <p>こんにちは、<strong><%= current_user.last_name %> <%= current_user.first_name %></strong> さん！</p>
  <p>診断名: <%= current_user.diagnosis_name %></p>
  
  <%= link_to "ログアウト", destroy_user_session_path, data: { "turbo-method": :delete } %>
<% else %>
  <p>ログインしていません。</p>
  <%= link_to "新規登録", new_user_registration_path %> |
  <%= link_to "ログイン", new_user_session_path %>
<% end %>
<div class="max-w-md mx-auto py-10 px-6">
  <%# --- ヘッダー・挨拶セクション --- %>
  <div class="text-center mb-10">
    <p class="text-xs font-bold text-blue-500 mb-1 tracking-widest uppercase">こんにちは</p>
    
    <h1 class="text-3xl font-extrabold text-gray-800 mb-2 tracking-tight">
      <% if current_user %>
        <%= current_user.name %> さん
      <% else %>
        ゲスト さん
      <% end %>
    </h1>
    
    <p class="text-sm text-gray-400 font-medium">今日の体調はいかがですか？</p>
  </div>

  <div class="space-y-6">
    <%# 1. 体調管理（カレンダー・履歴） %>
    <%= link_to daily_logs_path, class: "block no-underline group" do %>
      <div style="background-color: #ffffff; padding: 24px; border-radius: 24px; border: 1px solid #f3f4f6; box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1); display: flex; align-items: center; gap: 16px;">
        <div style="background-color: #f0fdf4; padding: 12px; border-radius: 16px; font-size: 24px;">📅</div>
        <div>
          <span style="display: block; font-weight: bold; color: #1f2937; font-size: 16px;">体調管理・カレンダー</span>
          <span style="display: block; color: #9ca3af; font-size: 12px; margin-top: 4px;">日々の記録入力と履歴の確認</span>
        </div>
      </div>
    <% end %>

    <%# 2. 分析・レポート（PDF出力機能を明示） %>
    <%= link_to analysis_daily_logs_path, class: "block no-underline group" do %>
      <div style="background-color: #ffffff; padding: 24px; border-radius: 24px; border: 1px solid #f3f4f6; box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1); display: flex; align-items: center; gap: 16px;">
        <div style="background-color: #fef2f2; padding: 12px; border-radius: 16px; font-size: 24px;">📊</div>
        <div>
          <span style="display: block; font-weight: bold; color: #1f2937; font-size: 16px;">データ分析・レポート</span>
          <span style="display: block; color: #9ca3af; font-size: 12px; margin-top: 4px;">グラフ分析とPDF・CSV出力</span>
        </div>
      </div>
    <% end %>

    <%# 3. 受診記録 %>
    <%= link_to visit_logs_path, class: "block no-underline group" do %>
      <div style="background-color: #ffffff; padding: 24px; border-radius: 24px; border: 1px solid #f3f4f6; box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1); display: flex; align-items: center; gap: 16px;">
        <div style="background-color: #eff6ff; padding: 12px; border-radius: 16px; font-size: 24px;">🏥</div>
        <div>
          <span style="display: block; font-weight: bold; color: #1f2937; font-size: 16px;">受診記録・検査結果</span>
          <span style="display: block; color: #9ca3af; font-size: 12px; margin-top: 4px;">診察内容や医師の指示をメモ</span>
        </div>
      </div>
    <% end %>

    <%# 4. 今日の記録ボタン（他のカードと同じデザインに統一） %>
    <%= link_to new_daily_log_path, class: "block no-underline group" do %>
      <div style="background-color: #ffffff; padding: 24px; border-radius: 24px; border: 1px solid #f3f4f6; box-shadow: 0 4px 6px -1px rgb(0 0 0 / 0.1); display: flex; align-items: center; gap: 16px;">
        <div style="background-color: #f8fafc; padding: 12px; border-radius: 16px; font-size: 24px; border: 1px dashed #cbd5e1;">📝</div>
        <div>
          <span style="display: block; font-weight: bold; color: #1f2937; font-size: 16px;">今日の体調を記録する</span>
          <span style="display: block; color: #9ca3af; font-size: 12px; margin-top: 4px;">今すぐ入力を始める</span>
        </div>
      </div>
    <% end %>
  </div>

 
</div>
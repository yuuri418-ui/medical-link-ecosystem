<div class="max-w-2xl mx-auto py-8 px-4">
  <div class="bg-white shadow-xl rounded-2xl overflow-hidden border border-blue-50">
    <div class="bg-blue-600 px-6 py-4">
      <h1 class="text-xl font-bold text-white flex items-center">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z" />
        </svg>
        今日の体調を記録する
      </h1>
    </div>

    <%= form_with(model: @daily_log, local: true, class: "p-6 space-y-8") do |f| %>
      
      <%# 日付選択 %>
      <div>
        <%= f.label :date, "記録日", class: "block text-sm font-bold text-gray-700 mb-2" %>
        <%= f.date_field :date, value: Date.today, class: "w-full rounded-lg border-gray-300 focus:ring-blue-500 focus:border-blue-500 shadow-sm" %>
      </div>

      <hr class="border-gray-100">

      <%# 総合体調 (1-5) %>
      <div>
        <%= f.label :condition, "総合的な体調", class: "block text-sm font-bold text-gray-700 mb-4" %>
        <div class="flex justify-between items-center bg-gray-50 p-4 rounded-xl">
          <% [["😫", 1], ["🙁", 2], ["😐", 3], ["🙂", 4], ["😆", 5]].each do |label, value| %>
            <label class="flex flex-col items-center cursor-pointer group">
              <%= f.radio_button :condition, value, class: "sr-only peer" %>
              <span class="text-3xl filter grayscale peer-checked:grayscale-0 transform transition group-hover:scale-110">
                <%= label %>
              </span>
              <span class="text-xs mt-1 text-gray-400 peer-checked:text-blue-600 font-bold"><%= value %></span>
            </label>
          <% end %>
        </div>
      </div>

      <%# 体温入力セクション %>
      <div class="bg-blue-50 p-4 rounded-xl border border-blue-100">
        <h2 class="text-sm font-bold text-blue-800 mb-3 flex items-center">
          <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
          </svg>
          体温の記録
        </h2>
  
        <%= f.fields_for :temperature_logs do |t_form| %>
          <div class="flex items-center space-x-4">
            <div class="flex-1">
              <%= t_form.label :value, "体温 (°C)", class: "block text-xs text-gray-500 mb-1" %>
              <%= t_form.number_field :value, step: 0.1, class: "w-full rounded-lg border-gray-300 focus:ring-blue-500 shadow-sm", placeholder: "36.5" %>
            </div>
            <div class="flex-1">
              <%= t_form.label :measured_at, "計測時刻", class: "block text-xs text-gray-500 mb-1" %>
              <%= t_form.time_field :measured_at, value: Time.current.strftime("%H:%M"), class: "w-full rounded-lg border-gray-300 focus:ring-blue-500 shadow-sm" %>
            </div>
          </div>
        <% end %>
      </div>

      <%# VAS 指標 (痛み・倦怠感) %>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
        <div>
          <div class="flex justify-between mb-2">
            <%= f.label :pain_vas, "痛みの強さ (VAS)", class: "text-sm font-bold text-gray-700" %>
            <span id="pain_value" class="text-blue-600 font-bold">0</span>
          </div>
          <%= f.range_field :pain_vas, min: 0, max: 10, value: 0, class: "w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-blue-600", oninput: "document.getElementById('pain_value').innerText = this.value" %>
          <div class="flex justify-between text-xs text-gray-400 mt-1"><span>なし</span><span>耐えられない</span></div>
        </div>

        <div>
          <div class="flex justify-between mb-2">
            <%= f.label :fatigue_vas, "倦怠感 (VAS)", class: "text-sm font-bold text-gray-700" %>
            <span id="fatigue_value" class="text-blue-600 font-bold">0</span>
          </div>
          <%= f.range_field :fatigue_vas, min: 0, max: 10, value: 0, class: "w-full h-2 bg-gray-200 rounded-lg appearance-none cursor-pointer accent-blue-600", oninput: "document.getElementById('fatigue_value').innerText = this.value" %>
          <div class="flex justify-between text-xs text-gray-400 mt-1"><span>なし</span><span>非常に強い</span></div>
        </div>
      </div>

      <%# 朝のこわばり %>
      <div>
        <%= f.label :stiffness_duration, "朝のこわばりの時間 (分)", class: "block text-sm font-bold text-gray-700 mb-2" %>
        <div class="relative">
          <%= f.number_field :stiffness_duration, class: "w-full pl-3 pr-12 py-2 border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500 shadow-sm", placeholder: "0" %>
          <span class="absolute right-3 top-2 text-gray-400 text-sm">分</span>
        </div>
      </div>

      <%# メモ %>
      <div>
        <%= f.label :memo, "自由記述メモ", class: "block text-sm font-bold text-gray-700 mb-2" %>
        <%= f.text_area :memo, rows: 4, class: "w-full border-gray-300 rounded-lg focus:ring-blue-500 focus:border-blue-500 shadow-sm", placeholder: "気になったことなど" %>
      </div>

      <%# 保存ボタン %>
      <div class="pt-4">
        <%= f.submit "記録を保存する", class: "w-full py-3 px-4 bg-blue-600 hover:bg-blue-700 text-white font-bold rounded-xl shadow-lg transition duration-200 transform hover:-translate-y-0.5" %>
        <%= link_to "キャンセル", root_path, class: "block text-center mt-4 text-sm text-gray-500 hover:text-gray-700" %>
      </div>
    <% end %>
  </div>
</div>
<div class="max-w-5xl mx-auto py-10 px-6">
  <div class="flex items-center justify-between mb-10">
    <h1 class="text-3xl font-extrabold text-gray-800 tracking-tight flex items-center">
      <span class="mr-3 p-2 bg-white rounded-2xl shadow-sm border border-gray-100">📅</span> 
      体調ログ履歴
    </h1>
    
    <% # 新規作成ボタンを右上に配置 %>
    <%= link_to new_daily_log_path, class: "bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-2xl font-bold shadow-lg shadow-blue-100 transition-all flex items-center" do %>
      <span class="mr-2">+</span> 記録する
    <% end %>
  </div>

  <div class="bg-white p-6 rounded-[32px] shadow-sm border border-gray-100">
  <%= month_calendar(events: @daily_logs, attribute: :date) do |date, logs| %>
    <div class="flex flex-col h-full">
      <% # 日付の数字 %>
      <div class="text-xs font-bold <%= date.today? ? 'text-blue-600' : 'text-gray-400' %>">
        <%= date.day %>
      </div>

      <div class="mt-1 flex-grow flex flex-col justify-center items-center">
        <% if logs.any? %>
          <% log = logs.first %>
          <%= link_to daily_log_path(log), class: "no-underline w-full text-center" do %>
            <% # 痛みと倦怠感の小さなバー %>
            <div class="flex gap-1 justify-center mb-1">
              <div class="w-1/3 h-1 bg-red-400 rounded-full"></div>
              <div class="w-1/3 h-1 bg-purple-400 rounded-full"></div>
            </div>
            <% # 数値の表示 %>
            <div class="text-[10px] font-black text-gray-700 leading-tight">
              P<%= log.pain_vas %> F<%= log.fatigue_vas %>
            </div>
          <% end %>
        <% else %>
          <%= link_to new_daily_log_path(date: date), class: "text-gray-200 no-underline hover:text-blue-400" do %>
            <span class="text-lg">+</span>
          <% end %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
</div>
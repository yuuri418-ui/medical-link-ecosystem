<div class="max-w-5xl mx-auto py-10 px-6">
  <div class="flex items-center justify-between mb-10">
    <h1 class="text-3xl font-extrabold text-gray-800 tracking-tight flex items-center">
      <span class="mr-3 p-2 bg-white rounded-2xl shadow-sm border border-gray-100">📅</span> 
      体調記録カレンダー
    </h1>
    
    <% # 新規作成ボタンを右上に配置 %>
    <%= link_to new_daily_log_path, class: "bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-2xl font-bold shadow-lg shadow-blue-100 transition-all flex items-center" do %>
      <span class="mr-2">+</span> 記録する
    <% end %>
  </div>

  <div class="bg-white p-6 rounded-[32px] shadow-sm border border-gray-100">
  <%= month_calendar(events: @daily_logs, attribute: :date, title: ->(date) { "#{date.year}年 #{date.month}月" } ) do |date, logs| %>
    <div class="flex flex-col h-full">
      <% # 日付の数字 %>
      <div class="text-xs font-bold <%= date.today? ? 'text-blue-600' : 'text-gray-400' %>">
        <%= date.day %>
      </div>

      <div class="mt-2 flex-grow flex flex-col justify-center items-center">
  <% if logs.any? %>
    <% log = logs.first %>
    <%= link_to daily_log_path(log), class: "no-underline w-full text-center group block" do %>
      
      <% # 1. 顔アイコン %>
      <div class="text-2xl mb-2 transition-transform group-hover:scale-110">
        <%= case log.condition.to_i
            when 5 then "😆"
            when 4 then "🙂"
            when 3 then "😐"
            when 2 then "😟"
            when 1 then "😫"
            else "😶"
            end %>
      </div>

    <% # 2. 痛みのインジケーター（スタイルを直接指定して確実に表示） %>
    <div class="flex justify-center gap-2 mt-2">
      <% # 痛みのドット（赤系） %>
      <div style="width: 12px; height: 12px; border-radius: 50%; flex-shrink: 0; background-color: <%= log.pain_vas.to_i > 5 ? '#ef4444' : '#fecaca' %>;" 
           title="痛み: <%= log.pain_vas %>"></div>
  
      <% # 倦怠感のドット（紫系） %>
      <div style="width: 12px; height: 12px; border-radius: 50%; flex-shrink: 0; background-color: <%= log.fatigue_vas.to_i > 5 ? '#a855f7' : '#e9d5ff' %>;" 
           title="倦怠感: <%= log.fatigue_vas %>"></div>
    </div>

    <% end %>
  <% else %>
    <% # 記録がない日の ＋ マーク %>
    <div class="flex justify-center items-center h-10">
      <%= link_to new_daily_log_path(date: date), class: "text-gray-200 no-underline hover:text-blue-400 transition-colors" do %>
        <span class="text-lg">+</span>
      <% end %>
    </div>
  <% end %>
</div>
  <% end %>
  </div>

  <div class="mt-4 flex justify-center gap-4 text-[10px] font-bold text-gray-400 uppercase tracking-widest">
  <div class="flex items-center gap-1">
    <div style="width: 8px; height: 8px; border-radius: 50%; background-color: #ef4444;"></div> 痛み (VAS)
  </div>
  <div class="flex items-center gap-1">
    <div style="width: 8px; height: 8px; border-radius: 50%; background-color: #a855f7;"></div> 倦怠感 (VAS)
  </div>
</div>
</div>


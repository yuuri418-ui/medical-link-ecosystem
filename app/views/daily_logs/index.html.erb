
<div class="max-w-5xl mx-auto py-10 px-6">
  <%# 1. ヘッダー全体のコンテナ：w-full で横幅を使い切ることを明示 %>
  <div class="w-full flex flex-row items-center justify-between mb-10">
    
    <%# 2. 左側：タイトル %>
    <div class="flex-shrink-0">
      <h1 class="text-3xl font-extrabold text-gray-800 tracking-tight flex items-center">
        <span class="mr-3 p-2 bg-white rounded-2xl shadow-sm border border-gray-100">📅</span> 
        体調記録カレンダー
      </h1>
    </div>
    
    <%# 3. 右側：ボタンの塊（ml-auto で右側に強制的に押し出す） %>
    <div class="flex items-center gap-3 ml-auto">
      <%# CSV出力ボタン %>
      <%= link_to daily_logs_path(format: :csv), class: "group bg-white hover:bg-green-50 text-green-600 border border-green-200 px-5 py-3 rounded-2xl font-bold shadow-sm transition-all flex items-center" do %>
        <span class="mr-2 text-lg group-hover:rotate-12 transition-transform">📊</span>
        <span class="text-sm">データ出力</span>
      <% end %>

      <%# 記録するボタン %>
      <%= link_to new_daily_log_path, class: "bg-blue-600 hover:bg-blue-700 text-white px-6 py-3 rounded-2xl font-bold shadow-lg shadow-blue-100 transition-all flex items-center" do %>
        <span class="mr-2">+</span> 記録する
      <% end %>
    </div>
  </div>

  <% # --- カレンダー部分はそのまま --- %>


  <%# --- 以下、カレンダー部分 --- %>
  <div class="bg-white p-6 rounded-[32px] shadow-sm border border-gray-100">
    <%= month_calendar(events: @daily_logs, attribute: :date, title: ->(date) { "#{date.year}年 #{date.month}月" } ) do |date, logs| %>
      
      <% # ✅ 1. その日の状態を判定 %>
      <% log = logs.first %>
      <% max_temp = log ? log.temperature_logs.maximum(:value).to_f : 0 %>
      
      <% # 背景色の決定 %>
      <% bg_color = if max_temp >= 37.5
                      '#fef2f2' # 高熱：ごく薄い赤 (Red 50)
                    elsif max_temp >= 37.0
                      '#fffbeb' # 微熱：ごく薄いオレンジ (Amber 50)
                    else
                      'transparent' # 平熱
                    end %>

      <% # ✅ 2. カード全体のコンテナに背景色を適用 %>
      <div class="flex flex-col h-full relative p-2 rounded-2xl transition-colors" 
           style="min-height: 110px; background-color: <%= bg_color %>;">
        
        <% if log %>
          <% # 発熱時のアクセント（右上の小さな三角も残すとより明確です） %>
          <% if max_temp >= 37.0 %>
            <div style="position: absolute; top: 0; right: 0; width: 0; height: 0; border-style: solid; border-width: 0 20px 20px 0; border-color: transparent <%= max_temp >= 38.0 ? '#ef4444' : '#f97316' %> transparent transparent; border-top-right-radius: 16px;"></div>
          <% end %>

          <% # 日付 %>
          <div class="text-xs font-bold <%= date.today? ? 'text-blue-600' : 'text-gray-400' %>">
            <%= date.day %>
          </div>

          <div class="mt-1 flex-grow flex flex-col justify-center items-center">
            <%= link_to daily_log_path(log), class: "no-underline w-full text-center group block" do %>
              <% # 顔アイコン %>
              <div class="text-2xl mb-1 transition-transform group-hover:scale-110">
                <% condition = log.condition.to_i %>
                <%= condition == 5 ? "😆" : (condition == 4 ? "🙂" : (condition == 3 ? "😐" : (condition == 2 ? "😟" : (condition == 1 ? "😫" : "😶")))) %>
              </div>

              <% # 痛み・倦怠感ドット %>
              <div class="flex justify-center gap-2 mt-1">
                <div style="width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; background-color: <%= log.pain_vas.to_i > 5 ? '#ef4444' : '#fecaca' %>;"></div>
                <div style="width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; background-color: <%= log.fatigue_vas.to_i > 5 ? '#a855f7' : '#e9d5ff' %>;"></div>
              </div>
            <% end %>
          </div>

        <% else %>
          <% # 記録なしの日 %>
          <div class="text-xs font-bold text-gray-400">
            <%= date.day %>
          </div>
          <div class="flex-grow flex justify-center items-center">
            <%= link_to new_daily_log_path(date: date), class: "text-gray-200 no-underline hover:text-blue-400" do %>
              <span class="text-lg">+</span>
            <% end %>
          </div>
        <% end %>
      </div>
    <% end %>
  </div>

  <% # ✅ 3. 凡例のアップデート %>
  <div class="mt-6 flex flex-wrap justify-center gap-6 text-[10px] font-bold text-gray-400 uppercase tracking-widest">
    <div class="flex items-center gap-2"><div style="width: 10px; height: 10px; border-radius: 50%; background-color: #ef4444;"></div> 痛み</div>
    <div class="flex items-center gap-2"><div style="width: 10px; height: 10px; border-radius: 50%; background-color: #a855f7;"></div> 倦怠感</div>
    <div class="flex items-center gap-2">
      <div style="width: 16px; height: 12px; background-color: #fffbeb; border: 1px solid #f97316; border-radius: 2px;"></div> 微熱 (37℃〜)
    </div>
    <div class="flex items-center gap-2">
      <div style="width: 16px; height: 12px; background-color: #fef2f2; border: 1px solid #ef4444; border-radius: 2px;"></div> 高熱 (37.5℃〜)
    </div>
  </div>
</div>
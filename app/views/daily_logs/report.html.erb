<div class="container mx-auto p-4 bg-white min-h-screen">
  
  <div class="flex justify-between items-end border-b-2 border-gray-800 pb-3 mb-6">
    <div>
      <h1 class="text-2xl font-bold text-gray-900 tracking-tight">
        体調管理サマリーレポート
      </h1>
      <p class="text-[10px] text-gray-500 uppercase tracking-widest mt-1 font-semibold italic">
        Daily Health Log Summary Report
      </p>
    </div>
    <div class="text-right text-xs leading-relaxed">
      <p class="text-[10px] text-gray-400 mb-1 font-bold">出力日: <%= Date.today.strftime('%Y/%m/%d') %></p>
      
      <p class="font-medium text-gray-700">
        診察券番号: <span class="text-base font-mono font-bold text-black ml-1"><%= current_user.patient_id.presence || "未登録" %></span>
      </p>
      <p class="text-gray-700 font-bold">
        氏名: <span class="text-sm ml-1"><%= current_user.name %></span> 様
      </p>
      <p class="text-gray-600">
        <% 
          gender_ja = case current_user.gender&.downcase
                     when 'male'   then '男性'
                     when 'female' then '女性'
                     when 'other'  then 'その他'
                     else current_user.gender || "ー"
                     end
        %>
        性別: <span class="font-medium"><%= gender_ja %></span> / 
        年齢: <span class="font-medium"><%= current_user.age %> 歳</span>
      </p>
    </div>
  </div>

  <div class="grid grid-cols-4 gap-2 mb-8">
    <div class="border border-gray-200 p-2 rounded bg-slate-50 text-center shadow-sm">
      <p class="text-[10px] text-gray-400 font-bold mb-1 uppercase tracking-tighter">Records</p>
      <p class="text-lg font-bold text-slate-800"><%= @daily_logs.count %> <span class="text-xs font-normal text-gray-400 font-normal">days</span></p>
    </div>
    <div class="border border-gray-200 p-2 rounded bg-slate-50 text-center border-l-4 border-l-red-500 shadow-sm">
      <p class="text-[10px] text-gray-400 font-bold mb-1 uppercase tracking-tighter text-red-600">Avg Pain</p>
      <p class="text-lg font-bold text-red-600"><%= @daily_logs.average(:pain_vas)&.round(1) || "0.0" %></p>
    </div>
    <div class="border border-gray-200 p-2 rounded bg-slate-50 text-center border-l-4 border-l-blue-500 shadow-sm">
      <p class="text-[10px] text-gray-400 font-bold mb-1 uppercase tracking-tighter text-blue-600">Avg Fatigue</p>
      <p class="text-lg font-bold text-blue-600"><%= @daily_logs.average(:fatigue_vas)&.round(1) || "0.0" %></p>
    </div>
    <div class="border border-gray-200 p-2 rounded bg-slate-50 text-center border-l-4 border-l-orange-500 shadow-sm">
      <p class="text-[10px] text-gray-400 font-bold mb-1 uppercase tracking-tighter text-orange-600">Max Temp</p>
      <p class="text-lg font-bold text-orange-600 whitespace-nowrap">
        <%= @daily_logs.joins(:temperature_logs).maximum('temperature_logs.value') || "--.-" %> <span class="text-xs font-bold italic">℃</span>
      </p>
    </div>
  </div>

  <div class="mb-10 shadow-sm">
    <table class="w-full text-left border-collapse border border-gray-300">
      <thead>
        <tr class="bg-gray-800 text-white text-[10px] uppercase tracking-wider">
          <th class="border border-gray-300 p-2 w-16 text-center font-normal">日付</th>
          <th class="border border-gray-300 p-2 w-24 text-center font-normal">体温 (℃)</th>
          <th class="border border-gray-300 p-2 w-14 text-center font-bold text-red-200">痛み</th>
          <th class="border border-gray-300 p-2 w-14 text-center font-bold text-blue-200">倦怠感</th>
          <th class="border border-gray-300 p-2 font-normal">服薬状況 (英名併記)</th>
          <th class="border border-gray-300 p-2 font-normal">特記事項</th>
        </tr>
      </thead>
      <tbody class="text-[11px] text-gray-800 leading-tight">
        <% @daily_logs.each do |log| %>
          <tr class="odd:bg-white even:bg-gray-50 border-b border-gray-200">
            <td class="border-x border-gray-300 p-2 text-center font-bold text-gray-600">
              <%= log.date.strftime('%m/%d') %>
            </td>
            
            <td class="border-x border-gray-300 p-2 text-center font-mono">
              <% temp = log.temperature_logs.first&.value %>
              <span class="<%= 'text-orange-600 font-bold' if temp && temp >= 37.5 %> whitespace-nowrap">
                <%= temp ? "#{temp}" : "ー" %>
                <% if temp %><span class="font-bold ml-0.5 text-xs">℃</span><% end %>
              </span>
            </td>

            <td class="border-x border-gray-300 p-2 text-center font-bold <%= log.pain_vas >= 7 ? 'bg-red-100 text-red-700 font-black' : 'text-gray-700' %>">
              <%= log.pain_vas %>
            </td>

            <td class="border-x border-gray-300 p-2 text-center font-bold <%= log.fatigue_vas >= 7 ? 'bg-blue-50 text-blue-700 font-black' : 'text-gray-700' %>">
              <%= log.fatigue_vas %>
            </td>

            <td class="border-x border-gray-300 p-2">
              <% log.medication_logs.where(is_taken: true).each do |med| %>
                <div class="mb-1 last:mb-0 whitespace-nowrap">
                  <span class="font-bold text-gray-900"><%= med.medicine_name %></span>
                  <% if med.english_name.present? %>
                    <span class="text-[9px] text-gray-400 italic ml-1 font-normal">(<%= med.english_name %>)</span>
                  <% end %>
                </div>
              <% end %>
            </td>

            <td class="border-x border-gray-300 p-2 text-gray-500 italic leading-snug">
              <%= truncate(log.memo, length: 40) %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>

  <div class="mt-auto pt-6 border-t border-gray-300">
    <div class="flex justify-between items-start">
      <div class="w-2/3 pr-10 text-gray-400">
        <p class="text-[10px] font-bold mb-2 tracking-widest uppercase text-gray-500">Physician's Notes / 患者メモ</p>
        <div class="w-full h-24 border border-gray-200 bg-gray-50 rounded p-3 text-[10px] leading-relaxed">
          診察時に相談したいこと、生活上の変化、または医師からの指示などを記入してください。
        </div>
      </div>
      <div class="w-1/4 text-center">
        <p class="text-[10px] font-bold text-gray-400 mb-2 uppercase tracking-tighter italic">Authorized Signature</p>
        <div class="w-full h-24 border-2 border-gray-400 bg-white flex items-center justify-center relative shadow-sm">
          <span class="text-[10px] text-gray-200 font-serif">確認印 / 署名</span>
        </div>
      </div>
    </div>
  </div>

</div>
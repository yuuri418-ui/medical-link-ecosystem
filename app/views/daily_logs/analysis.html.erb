<div class="max-w-2xl mx-auto py-8 px-4" 
     data-controller="heatmap" 
     data-heatmap-counts-value="<%= @pain_counts.to_json %>"
     data-heatmap-max-value="<%= @max_count %>">
  
  <h1 class="text-2xl font-bold text-gray-800 mb-6 flex items-center">
    <span class="mr-2">📊</span> 痛みの分析ヒートマップ
  </h1>

  <% # 📅 期間指定フォーム %>
  <div class="bg-white p-6 rounded-3xl shadow-lg border border-gray-100 mb-8">
    <%= form_with url: analysis_daily_logs_path, method: :get, local: true do |f| %>
      <div class="grid grid-cols-2 gap-4 mb-6">
        <div>
          <%= f.label :start_date, "開始日", class: "text-[10px] font-bold text-gray-400 mb-1 block uppercase tracking-wider" %>
          <%= f.date_field :start_date, value: @start_date, class: "w-full rounded-xl border-gray-200 text-sm" %>
        </div>
        <div>
          <%= f.label :end_date, "終了日", class: "text-[10px] font-bold text-gray-400 mb-1 block uppercase tracking-wider" %>
          <%= f.date_field :end_date, value: @end_date, class: "w-full rounded-xl border-gray-200 text-sm" %>
        </div>
      </div>
      
      <% # ✅ 物理的にスタイルを固定したボタン %>
      <button type="submit" 
              style="background-color: #1f2937; color: white; width: 100%; padding: 12px; border-radius: 16px; border: none; font-weight: bold; cursor: pointer; display: block; text-align: center;">
        分析期間を更新
      </button>
    <% end %>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-8">
  
  <% # 左側：ヒートマップ %>
  <div class="bg-white p-6 rounded-3xl shadow-sm border border-gray-100">
    <h2 class="text-sm font-bold text-gray-700 mb-4 flex items-center">
      <span class="mr-2">👤</span> 痛みの部位分布
    </h2>
    <div class="flex flex-col items-center">
      <% if @has_pain_data %>
        <div class="w-48 mb-6">
          <%= render 'shared/body_schema_display' %>
        </div>
        <% # 凡例などはそのまま %>
      <% else %>
        <p class="py-20 text-xs text-gray-400">期間内の痛み記録はありません</p>
      <% end %>
    </div>
  </div>
  
  <% # 右側：指標グラフエリア %>
<div class="bg-white p-6 rounded-3xl shadow-sm border border-gray-100">
  <h2 class="text-sm font-bold text-gray-700 mb-4 flex items-center">
    <span class="mr-2">📈</span> 体調・指標の推移
  </h2>

  <div class="space-y-6">
    <% # 1. 体温グラフ（緑系） %>
    <div>
      <p class="text-[10px] font-bold text-gray-400 mb-2 uppercase">最高体温 (°C)</p>
      <%= line_chart @temperature_data,
                     min: 35.0, max: 40.0,
                     points: true,
                     curve: true,
                     colors: ["#10b981"],
                     height: "120px" %>
    </div>

    <% # 2. 痛みグラフ（青系） %>
    <div>
      <p class="text-[10px] font-bold text-gray-400 mb-2 uppercase">痛み (VAS: 0-10)</p>
      <%= line_chart @pain_vas_data,
                     min: 0, max: 10,
                     points: true,
                     curve: true,
                     colors: ["#3b82f6"],
                     height: "120px" %>
    </div>

    <% # 3. 倦怠感グラフ（紫系） %>
    <div>
      <p class="text-[10px] font-bold text-gray-400 mb-2 uppercase">倦怠感 (VAS: 0-10)</p>
      <%= line_chart @fatigue_vas_data,
                     min: 0, max: 10,
                     points: true,
                     curve: true,
                     colors: ["#8b5cf6"],
                     height: "120px" %>
    </div>
  </div>
</div>
 
 
</div>
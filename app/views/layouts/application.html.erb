<!DOCTYPE html>
<html>
  <head>
    <title>MyHealth Log</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%# スタイルの読み込み %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    
    <%# Tailwind CSS CDN %>
    <script src="https://cdn.tailwindcss.com"></script>

    <style>
      body { background-color: #fcfcfc; }
      /* SVGアイコンのサイズ固定 */
      svg { width: 1.25rem; height: 1.25rem; display: inline-block; }
    </style>
  </head>

  <body class="bg-gray-50 antialiased">
    <%# --- ヘッダー（青背景・白文字） --- %>
    <header class="bg-blue-600 text-white shadow-sm sticky top-0 z-50">
      <%# ✅ max-w-full に変更して横幅を広げました %>
      <div class="max-w-full mx-auto flex justify-between items-center py-4 px-6">
        
        <%# 左端：ロゴ %>
        <%= link_to "MyHealth Log", root_path, class: "text-xl font-black no-underline text-white tracking-tight" %>
        
        <%# 右端：ユーザー情報とボタン %>
        <div class="flex items-center gap-4">
          <% if user_signed_in? %>
    <%# ✅ 修正：ユーザー名をリンクにして、編集画面へ飛べるようにします %>
    <%= link_to edit_user_registration_path, class: "text-sm font-bold opacity-90 no-underline text-white hover:underline flex items-center gap-1" do %>
      <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
      </svg>
      <%= current_user.name %> さん
    <% end %>
            
            <%= link_to destroy_user_session_path, data: { "turbo-method": :delete }, 
                        class: "text-xs font-bold text-white border border-white/40 rounded-full px-3 py-1.5 hover:bg-white/10 transition-all flex items-center gap-1 no-underline" do %>
              ログアウト
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 9V5.25A2.25 2.25 0 0013.5 3h-6a2.25 2.25 0 00-2.25 2.25v13.5A2.25 2.25 0 007.5 21h6a2.25 2.25 0 002.25-2.25V15M12 9l-3 3m0 0l3 3m-3-3h12.75" />
              </svg>
            <% end %>
          <% else %>
            <%= link_to "ログイン", new_user_session_path, class: "text-sm font-bold text-white no-underline border border-white/40 rounded-full px-4 py-1.5" %>
          <% end %>
        </div>
      </div>
    </header>

    <%# --- メインコンテンツ --- %>
    <main>
      <%= yield %>
    </main>

    <%# フラッシュメッセージ %>
    <% if notice || alert %>
      <div class="fixed top-20 left-0 right-0 flex justify-center z-50 pointer-events-none">
        <div class="px-4 py-2 rounded-full shadow-lg text-xs font-bold <%= notice ? 'bg-green-500 text-white' : 'bg-red-500 text-white' %>">
          <%= notice || alert %>
        </div>
      </div>
    <% end %>
  </body>
</html>
<%= form_with(model: visit_log, local: true, class: "space-y-6") do |f| %>

  <%# 基本情報セクション %>
  <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 space-y-4">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <%= f.label :visited_on, "受診日", class: "block text-sm font-medium text-gray-700" %>
        <%= f.date_field :visited_on, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
      </div>
      <div>
        <%= f.label :hospital_name, "病院名", class: "block text-sm font-medium text-gray-700" %>
        <%= f.text_field :hospital_name, placeholder: "〇〇大学病院", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <%= f.label :department, "受診科", class: "block text-sm font-medium text-gray-700" %>
        <%= f.text_field :department, placeholder: "リウマチ膠原病内科", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
      </div>
      <div>
        <%= f.label :doctor_name, "担当医", class: "block text-sm font-medium text-gray-700" %>
        <%= f.text_field :doctor_name, placeholder: "山田 先生", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
      </div>
    </div>
  </div>

  <%# 血液検査結果セクション %>
  <div class="bg-blue-50 p-6 rounded-2xl border border-blue-100">
    <h2 class="text-lg font-bold text-blue-900 mb-4">🩸 血液検査結果</h2>
    <%= f.fields_for :blood_test_results do |b| %>
      <div class="grid grid-cols-3 gap-2 mb-2">
        <%= b.text_field :item_name, placeholder: "項目", class: "rounded-md border-gray-200" %>
        <%= b.number_field :value, step: 0.01, placeholder: "数値", class: "rounded-md border-gray-200" %>
        <%= b.text_field :unit, placeholder: "単位", class: "rounded-md border-gray-200" %>
      </div>
    <% end %>
  </div>

  <%# 処方薬セクション %>
  <div class="bg-green-50 p-6 rounded-2xl border border-green-100">
    <h2 class="text-lg font-bold text-green-900 mb-4">💊 今回処方された薬</h2>
    <%= f.fields_for :prescribed_medicines do |p| %>
      <div class="grid grid-cols-2 gap-2 mb-2">
        <%= p.text_field :name, placeholder: "薬名", class: "rounded-md border-gray-200" %>
        <%= p.text_field :dosage, placeholder: "用量", class: "rounded-md border-gray-200" %>
      </div>
    <% end %>
  </div>

  <%# メモセクション %>
  <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
    <%= f.label :memo, "備考・メモ", class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_area :memo, rows: 4, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
  </div>

  <div class="pt-4">
    <%= f.submit yield(:button_text), class: "w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 rounded-xl shadow-lg transition" %>
  </div>
<% end %>
<%= form_with(model: visit_log, local: true, class: "space-y-6") do |f| %>

  <%# 基本情報セクション %>
  <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100 space-y-4">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <%= f.label :visited_on, "受診日", class: "block text-sm font-medium text-gray-700" %>
        <%= f.date_field :visited_on, class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
      </div>
      <div>
        <%= f.label :hospital_name, "病院名", class: "block text-sm font-medium text-gray-700" %>
        <%= f.text_field :hospital_name, placeholder: "〇〇大学病院", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
      </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <div>
        <%= f.label :department, "受診科", class: "block text-sm font-medium text-gray-700" %>
        <%= f.text_field :department, placeholder: "リウマチ膠原病内科", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
      </div>
      <div>
        <%= f.label :doctor_name, "担当医", class: "block text-sm font-medium text-gray-700" %>
        <%= f.text_field :doctor_name, placeholder: "山田 先生", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
      </div>
    </div>
  </div>

  <%# 血液検査結果セクション (blood_test_items に変更) %>
  <div class="bg-blue-50 p-6 rounded-2xl border border-blue-100">
    <div class="flex justify-between items-center mb-4">
      <h2 class="text-lg font-bold text-blue-900">🩸 血液検査結果</h2>
      <span class="text-xs text-blue-600 bg-white px-2 py-1 rounded-full border border-blue-100">分析用データ</span>
    </div>
    
    <div class="space-y-3">
      <div class="hidden md:grid grid-cols-12 gap-2 px-2 text-xs font-bold text-blue-700">
        <div class="col-span-3">項目名 (例: CRP)</div>
        <div class="col-span-2">数値</div>
        <div class="col-span-2">単位</div>
        <div class="col-span-3">カテゴリー</div>
        <div class="col-span-2">基準値</div>
      </div>

      <%= f.fields_for :blood_test_items do |item_f| %>
        <div class="grid grid-cols-1 md:grid-cols-12 gap-2 p-3 bg-white rounded-xl shadow-sm border border-blue-50">
          <div class="col-span-3">
            <%= item_f.text_field :name, placeholder: "項目", class: "w-full text-sm rounded-md border-gray-200 focus:ring-blue-500" %>
          </div>
          <div class="col-span-2">
            <%= item_f.number_field :value, step: 0.01, placeholder: "数値", class: "w-full text-sm rounded-md border-gray-200 focus:ring-blue-500" %>
          </div>
          <div class="col-span-2">
            <%= item_f.text_field :unit, placeholder: "単位", class: "w-full text-sm rounded-md border-gray-200 focus:ring-blue-500" %>
          </div>
          <div class="col-span-3">
            <%= item_f.text_field :category, placeholder: "カテゴリー", class: "w-full text-sm rounded-md border-gray-200 focus:ring-blue-500" %>
          </div>
          <div class="col-span-2 flex items-center gap-2">
            <%= item_f.text_field :reference_range, placeholder: "基準", class: "w-full text-sm rounded-md border-gray-200 focus:ring-blue-500" %>
            <% if item_f.object.persisted? %>
              <%= item_f.check_box :_destroy, class: "rounded text-red-500 focus:ring-red-500" %>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
    <p class="mt-3 text-[10px] text-blue-400 italic">※数値を空にすると保存されません。</p>
  </div>

  <% # 処方薬セクション %>
  <div class="bg-green-50 p-6 rounded-2xl border border-green-100">
    <h2 class="text-lg font-bold text-green-900 mb-4">💊 今回処方された薬</h2>
    <div class="space-y-2">
      <%= f.fields_for :prescribed_medicines do |p| %>
        <div class="grid grid-cols-2 gap-2">
          <%= p.text_field :name, placeholder: "薬名", class: "rounded-md border-gray-200 text-sm" %>
          <%= p.text_field :dosage, placeholder: "用量", class: "rounded-md border-gray-200 text-sm" %>
        </div>
      <% end %>
    </div>
  </div>

  <%# メモセクション %>
  <div class="bg-white p-6 rounded-2xl shadow-sm border border-gray-100">
    <%= f.label :memo, "備考・メモ", class: "block text-sm font-medium text-gray-700" %>
    <%= f.text_area :memo, rows: 4, placeholder: "先生に相談したこと、次回の検査予定など", class: "mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-blue-500 focus:ring-blue-500" %>
  </div>

  <div class="pt-4">
    <%= f.submit yield(:button_text), class: "w-full bg-blue-600 hover:bg-blue-700 text-white font-bold py-4 rounded-2xl shadow-lg shadow-blue-200 transition-all active:scale-[0.98]" %>
  </div>
<% end %>
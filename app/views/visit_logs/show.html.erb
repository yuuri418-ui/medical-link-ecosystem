<div class="max-w-4xl mx-auto py-8 px-4">
  <div class="flex justify-between items-center mb-6">
    <%= link_to '← 戻る', visit_logs_path, class: "text-gray-500 hover:text-blue-600 font-medium" %>
    <div class="space-x-2">
      <%= link_to '編集する', edit_visit_log_path(@visit_log), class: "bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg font-bold shadow-sm transition" %>
    </div>
  </div>

  <div class="bg-white rounded-3xl shadow-xl overflow-hidden border border-gray-100">
    <%# ヘッダー %>
    <div class="bg-gradient-to-r from-blue-600 to-blue-500 p-8 text-white">
      <div class="flex justify-between items-start">
        <div>
          <p class="text-blue-100 text-sm font-bold mb-1"><%= @visit_log.visited_on.strftime("%Y年 %m月 %d日") %></p>
          <h1 class="text-3xl font-bold"><%= @visit_log.hospital_name %></h1>
        </div>
        <div class="text-right">
          <span class="bg-white/20 px-3 py-1 rounded-full text-sm font-bold"><%= @visit_log.department %></span>
          <p class="mt-2 text-sm text-blue-50 font-medium">担当：<%= @visit_log.doctor_name.presence || "未入力" %></p>
        </div>
      </div>
    </div>

    <div class="p-8 space-y-10">
      <%# 血液検査セクション %>
      <section>
        <h2 class="text-lg font-bold text-gray-800 mb-4 flex items-center border-l-4 border-blue-500 pl-3">
          🩸 血液検査結果
        </h2>
        <div class="bg-gray-50 rounded-2xl overflow-hidden">
          <table class="w-full text-left">
            <thead class="bg-gray-100 text-gray-600 text-xs uppercase font-bold">
              <tr>
                <th class="px-6 py-3">項目名</th>
                <th class="px-6 py-3">数値</th>
                <th class="px-6 py-3">単位</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-200">
              <% @visit_log.blood_test_results.each do |result| %>
                <tr class="hover:bg-white transition">
                  <td class="px-6 py-4 text-sm font-bold text-gray-700"><%= result.item_name %></td>
                  <td class="px-6 py-4 text-sm text-blue-600 font-mono font-bold"><%= result.value %></td>
                  <td class="px-6 py-4 text-sm text-gray-500"><%= result.unit %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
          <% if @visit_log.blood_test_results.empty? %>
            <p class="p-6 text-sm text-gray-400 italic text-center">検査結果の登録はありません</p>
          <% end %>
        </div>
      </section>

      <%# 処方薬セクション %>
      <section>
        <h2 class="text-lg font-bold text-gray-800 mb-4 flex items-center border-l-4 border-green-500 pl-3">
          💊 今回処方された薬
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <% @visit_log.prescribed_medicines.each do |med| %>
            <div class="bg-green-50 border border-green-100 p-4 rounded-xl flex justify-between items-center">
              <span class="font-bold text-green-800"><%= med.name %></span>
              <span class="text-sm bg-white px-2 py-1 rounded text-gray-600 shadow-sm"><%= med.dosage %></span>
            </div>
          <% end %>
        </div>
      </section>

      <%# メモセクション %>
      <% if @visit_log.memo.present? %>
        <section>
          <h2 class="text-lg font-bold text-gray-800 mb-4 flex items-center border-l-4 border-gray-400 pl-3">
            📝 医師からの説明・メモ
          </h2>
          <div class="bg-gray-50 p-6 rounded-2xl text-gray-700 leading-relaxed whitespace-pre-wrap"><%= @visit_log.memo %></div>
        </section>
      <% end %>
    </div>
  </div>
</div>